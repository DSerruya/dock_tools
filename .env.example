# GitHub webhook HMAC-SHA256 secret
# Must match the "Secret" field in each GitHub repo's webhook settings
WEBHOOK_SECRET=change_me_use_openssl_rand_hex_32

# Absolute path to scripts-data directory on the HOST machine
# The manager container uses this to create correct bind mounts for script containers
HOST_SCRIPTS_DATA_PATH=/opt/script-manager/scripts-data

# Default timezone for cron schedules (per-script timezone overrides this)
# Examples: UTC, America/New_York, Europe/London, Asia/Tokyo
DEFAULT_TIMEZONE=UTC

# Port exposed on the host for the web UI (default: 80)
MANAGER_PORT=80
